# Development only. These fixture credentials must never be used outside loopback.
SW_MODE=server
SW_HOST=127.0.0.1
SW_PORT=4310
SW_PUBLIC_URL=http://127.0.0.1:4310
# Rebuildable index; keep it on local disk. It also indexes each person's working copy.
SW_CACHE_DIR=/tmp/sw-cache
SW_OIDC_PROVIDER=keycloak
SW_OIDC_ISSUER=http://127.0.0.1:8080/realms/workbench
SW_OIDC_CLIENT_ID=semantic-workbench
SW_OIDC_CLIENT_SECRET=semantic-workbench-test-secret
# Generate a key with `openssl rand -base64 32` before first startup.
SW_SESSION_KEY=
SW_BOOTSTRAP_ADMINS=dave@example.org
# Number of reverse proxies in front of the workbench that append to X-Forwarded-For (0 to 5).
# Leave it at 0 when nothing sits in front; behind Azure Container Apps ingress it is 1.
# SW_TRUSTED_PROXY_HOPS=0
# Entra only: the API app's client id, the audience of agent clients' v2 access tokens.
# SW_API_AUDIENCE=
# Entra signs in through MSAL with an App Registration. Its credential is one of: a certificate
# (preferred; both values from Key Vault), a client secret, or
# SW_OIDC_CLIENT_ASSERTION=managed-identity.
# SW_OIDC_CLIENT_CERTIFICATE_KEY=
# SW_OIDC_CLIENT_CERTIFICATE_THUMBPRINT=
