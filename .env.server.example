# Development only. These fixture credentials must never be used outside loopback.
SW_MODE=server
SW_HOST=127.0.0.1
SW_PORT=4310
SW_PUBLIC_URL=http://127.0.0.1:4310
# Rebuildable index; keep it on local disk. It also indexes each person's working copy.
SW_CACHE_DIR=/tmp/sw-cache
SW_OIDC_PROVIDER=keycloak
SW_OIDC_ISSUER=http://127.0.0.1:8080/realms/workbench
SW_OIDC_CLIENT_ID=semantic-workbench
SW_OIDC_CLIENT_SECRET=semantic-workbench-test-secret
# Generate a key with `openssl rand -base64 32` before first startup.
SW_SESSION_KEY=
SW_BOOTSTRAP_ADMINS=dave@example.org
# Number of reverse proxies in front of the workbench that append to X-Forwarded-For (0 to 5).
# Leave it at 0 when nothing sits in front; behind Azure Container Apps ingress it is 1.
# SW_TRUSTED_PROXY_HOPS=0
# Entra only: the API app's client id, the audience of agent clients' v2 access tokens.
# SW_API_AUDIENCE=
# Entra signs in through MSAL with an App Registration. Its credential is one of: a certificate
# (preferred; both values from Key Vault), a client secret, or
# SW_OIDC_CLIENT_ASSERTION=managed-identity.
# SW_OIDC_CLIENT_CERTIFICATE_KEY=
# SW_OIDC_CLIENT_CERTIFICATE_THUMBPRINT=
# Entra only: the directory (tenant) ID; the issuer must then be https://<login host>/<tenant>/v2.0.
# SW_ENTRA_TENANT_ID=
# Optional GitHub app for "Connect GitHub" (set both or neither) and its host.
# SW_GITHUB_CLIENT_ID=
# SW_GITHUB_CLIENT_SECRET=
# SW_GITHUB_HOST=github.com
# Committer identity of server commits; the author is always the signed-in person.
# SW_COMMITTER_NAME=Semantic Workbench
# SW_COMMITTER_EMAIL=workbench@localhost
# Logging: debug, info (default), warn, error or silent. Server mode writes JSON lines to stdout.
# SW_LOG_LEVEL=info
# Telemetry is off unless this is set (a Key Vault reference in Azure). Never commit a real value.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
# Share of traces kept, from 0 to 1; metrics and logs are not sampled.
# SW_TRACE_SAMPLE_RATIO=0.1
# Secret that keys the pseudonym of each person in logs and telemetry. Without it, each start uses
# a new one.
# SW_TELEMETRY_ACTOR_SALT=
# Every variable, with defaults, is in specs/003-authn-authz/contracts/configuration.md.
