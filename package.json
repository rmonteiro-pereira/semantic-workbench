{
  "name": "semantic-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run schemas:compile && vp build",
    "test": "bun test",
    "check": "tsc --noEmit && bun run fmt:check && bun run lint && bun run check:comments",
    "check:comments": "bun scripts/check-comments.ts",
    "fmt": "bunx --bun oxfmt src server scripts tests vite.config.ts",
    "fmt:check": "bunx --bun oxfmt --check src server scripts tests vite.config.ts",
    "lint": "bunx --bun oxlint --quiet src server scripts tests",
    "lint:full": "bunx --bun oxlint src server scripts tests",
    "test:ui": "bun scripts/ui-tests.ts",
    "test:mutation": "bun scripts/mutation-tests.ts",
    "examples:generate": "bun scripts/billing-example.ts && bun scripts/mall-example.ts",
    "test:examples": "bun scripts/verify-examples.ts",
    "test:examples:ui": "bun scripts/examples-ui-tests.ts",
    "test:responsive": "bun scripts/responsive-ui-tests.ts",
    "test:edges": "bun scripts/edge-attachment-ui-tests.ts",
    "test:grouping-validation": "bun scripts/grouping-validation-ui-tests.ts",
    "inspect:mall": "bun scripts/mall-visual-inspect.ts /tmp/mall-inspect",
    "test:projects": "bun scripts/projects-browser-check.ts",
    "test:trash": "bun scripts/trash-browser-check.ts",
    "test:metrics": "bun scripts/metrics-browser-check.ts",
    "test:graph": "bun scripts/graph-browser-check.ts",
    "test:editor": "bun scripts/editor-browser-check.ts",
    "test:item-edit": "bun scripts/item-edit-browser-check.ts",
    "test:rdf-edit": "bun scripts/rdf-edit-browser-check.ts",
    "test:scm": "bun scripts/scm-browser-check.ts",
    "test:odcs": "bun scripts/odcs-browser-check.ts",
    "test:lineage": "bun scripts/lineage-browser-check.ts",
    "test:autosave": "bun scripts/autosave-browser-check.ts",
    "test:sql": "bun scripts/sql-browser-check.ts",
    "test:git-setup": "bun scripts/git-setup-browser-check.ts",
    "test:monorepo": "bun scripts/monorepo-browser-check.ts",
    "test:dialogs": "bun scripts/dialogs-browser-check.ts",
    "test:terminology": "bun scripts/terminology-check.ts",
    "test:mappings-layout": "bun scripts/mappings-layout-browser-check.ts",
    "test:mapping-graph": "bun scripts/mapping-graph-browser-check.ts",
    "mock-oidc": "bun scripts/mock-oidc.ts",
    "test:auth": "bun run build && bun scripts/auth-browser-check.ts",
    "test:auth:keycloak": "bun run build && bun scripts/auth-keycloak-check.ts",
    "test:admin": "bun scripts/admin-browser-check.ts",
    "test:two-editors": "bun scripts/two-editors-check.ts",
    "test:container": "bun scripts/container-check.ts",
    "schemas:compile": "bun scripts/compile-schemas.ts",
    "ci:validate": "bun scripts/ci-validate.ts",
    "image:build": "bun scripts/image.ts build",
    "image:scan": "bun scripts/image.ts scan",
    "image:sbom": "bun scripts/image.ts sbom",
    "image:push": "bun scripts/image.ts push",
    "pipeline:lint": "bun scripts/pipeline-lint.ts",
    "pipeline:dry-run": "bun scripts/pipeline-dry-run.ts",
    "deploy:check-version": "bun scripts/deploy-version.ts"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "@xyflow/react": "^12.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cytoscape": "^3.34.4",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "^0.12.0",
    "jose": "6.2.13",
    "lucide-react": "^0.468.0",
    "n3": "^2.13.12",
    "node-sql-parser": "^5.4.0",
    "openid-client": "6.8.8",
    "rdflib": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@types/cytoscape": "^3.31.0",
    "@types/n3": "^1.26.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  }
}
