{
  "name": "semantic-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run schemas:compile && vp build",
    "test": "bun test",
    "check": "tsc --noEmit && bun run fmt:check && bun run lint && bun run check:comments && bun run check:theme && bun run check:brand",
    "check:comments": "bun scripts/check-comments.ts",
    "check:theme": "bun scripts/check-theme.ts",
    "check:brand": "bun scripts/check-brand.ts",
    "theme:codemod": "bun scripts/theme-codemod.ts",
    "fmt": "bunx --bun oxfmt src scripts tests vite.config.ts",
    "fmt:check": "bunx --bun oxfmt --check src scripts tests vite.config.ts",
    "lint": "bunx --bun oxlint --quiet src scripts tests",
    "lint:full": "bunx --bun oxlint src scripts tests",
    "test:ui": "bun scripts/ui-tests.ts",
    "polish:capture": "bun scripts/polish-capture.ts",
    "polish:capture:server": "bun scripts/polish-capture-server.ts",
    "test:mutation": "bun scripts/mutation-tests.ts",
