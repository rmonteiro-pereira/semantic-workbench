<rdf:RDF xml:base="https://example.org/commerce"
 xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
 xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
 xmlns:owl="http://www.w3.org/2002/07/owl#">
    <owl:Ontology rdf:about="">
        <rdfs:label>Commerce OWL ontology</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    <owl:Class rdf:about="/commerce#Customer">
        <rdfs:comment>Customer in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Customer</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#Order">
        <rdfs:comment>Order in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Order</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#OrderLine">
        <rdfs:comment>OrderLine in the order-to-cash process.</rdfs:comment>
        <rdfs:label>OrderLine</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#Product">
        <rdfs:comment>Product in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Product</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#Shipment">
        <rdfs:comment>Shipment in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Shipment</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#Invoice">
        <rdfs:comment>Invoice in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Invoice</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#Payment">
        <rdfs:comment>Payment in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Payment</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="/commerce#Warehouse">
        <rdfs:comment>Warehouse in the order-to-cash process.</rdfs:comment>
        <rdfs:label>Warehouse</rdfs:label>
    </owl:Class>
    <owl:ObjectProperty rdf:about="/commerce#places">
        <rdfs:domain rdf:resource="/commerce#Customer"/>
        <rdfs:label>places</rdfs:label>
        <rdfs:range rdf:resource="/commerce#Order"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="/commerce#contains">
        <rdfs:domain rdf:resource="/commerce#Order"/>
        <rdfs:label>contains</rdfs:label>
        <rdfs:range rdf:resource="/commerce#OrderLine"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="/commerce#product">
        <rdfs:domain rdf:resource="/commerce#OrderLine"/>
        <rdfs:label>product</rdfs:label>
        <rdfs:range rdf:resource="/commerce#Product"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="/commerce#shipment">
        <rdfs:domain rdf:resource="/commerce#Order"/>
        <rdfs:label>shipment</rdfs:label>
        <rdfs:range rdf:resource="/commerce#Shipment"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="/commerce#invoice">
        <rdfs:domain rdf:resource="/commerce#Order"/>
        <rdfs:label>invoice</rdfs:label>
        <rdfs:range rdf:resource="/commerce#Invoice"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="/commerce#payment">
        <rdfs:domain rdf:resource="/commerce#Invoice"/>
        <rdfs:label>payment</rdfs:label>
        <rdfs:range rdf:resource="/commerce#Payment"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="/commerce#warehouse">
        <rdfs:domain rdf:resource="/commerce#Shipment"/>
        <rdfs:label>warehouse</rdfs:label>
        <rdfs:range rdf:resource="/commerce#Warehouse"/>
    </owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="/commerce#email">
        <rdfs:domain rdf:resource="/commerce#Customer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="/commerce#amount">
        <rdfs:domain rdf:resource="/commerce#Order"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    <owl:ObjectProperty rdf:about="/commerce#placedBy">
        <rdfs:domain rdf:resource="/commerce#Order"/>
        <rdfs:range rdf:resource="/commerce#Customer"/>
        <owl:inverseOf rdf:resource="/commerce#places"/>
    </owl:ObjectProperty>
    <owl:Class rdf:about="/commerce#PaidOrder">
        <rdfs:subClassOf rdf:resource="/commerce#Order"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="/commerce#invoice"/>
                <owl:someValuesFrom rdf:resource="/commerce#Invoice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
</rdf:RDF>
