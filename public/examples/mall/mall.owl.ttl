@prefix core: <https://example.org/mall/core#> .
@prefix asset: <https://example.org/mall/asset#> .
@prefix party: <https://example.org/mall/party#> .
@prefix lease: <https://example.org/mall/lease#> .
@prefix legal: <https://example.org/mall/legal#> .
@prefix hr: <https://example.org/mall/hr#> .
@prefix proc: <https://example.org/mall/proc#> .
@prefix ops: <https://example.org/mall/ops#> .
@prefix fin: <https://example.org/mall/fin#> .
@prefix perf: <https://example.org/mall/perf#> .
@prefix kpi: <https://example.org/mall/kpi#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
<https://example.org/mall/ontology> a owl:Ontology ; rdfs:label "Shopping center administration OWL ontology" ; rdfs:comment "Fictional reference model for administering shopping centers and other retail real estate: assets and space, tenants and brands, the leasing pipeline, leases and their clauses, service charges and operations, billing and collections, accounting and investor distributions, and performance facts. Each module has its own namespace." ; owl:versionInfo "1.0.0" .

# core: Shared parties, places, calendar and currencies
# asset: Properties, buildings, floors and spaces
# party: Tenant, investor and broker roles, brands and tenant mix
# lease: Leasing pipeline, leases and clauses
# legal: Contract register, legal entities, governance, litigation and compliance
# hr: Organization structure, employees, payroll and talent
# proc: Suppliers, sourcing, purchasing and payables
# ops: Service charges, maintenance, utilities and marketing
# fin: Billing, collections, ledger, budgets, tax, assets, debt and treasury
# perf: Occupancy, tenant sales, footfall and parking facts
# kpi: Governed performance indicators

core:Party a owl:Class ; rdfs:label "Party" ; rdfs:comment "Abstract legal or natural person. The roles a party plays (tenant, investor, broker, supplier, employee, legal entity, contract counterparty) are separate concepts that refer to the party, so one company can be a supplier and a counterparty at the same time." .
core:Organization a owl:Class ; rdfs:label "Organization" ; rdfs:comment "Legal entity such as a company, fund, bank, insurer, public authority, court, law firm or condominium association." ;
  rdfs:subClassOf core:Party ;
  skos:closeMatch schema:Organization .
core:Person a owl:Class ; rdfs:label "Person" ; rdfs:comment "Natural person: employee, tenant contact, attorney, candidate, guarantor or individual investor. Personal data is subject to data-protection law." ;
  rdfs:subClassOf core:Party ;
  skos:closeMatch schema:Person .
core:Address a owl:Class ; rdfs:label "Address" ; rdfs:comment "Postal address of a property or party." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty core:addressCity ; owl:someValuesFrom core:City ] ;
  skos:closeMatch schema:PostalAddress .
core:City a owl:Class ; rdfs:label "City" ; rdfs:comment "Municipality." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty core:cityState ; owl:someValuesFrom core:StateProvince ] ;
  skos:closeMatch schema:City .
core:StateProvince a owl:Class ; rdfs:label "State Province" ; rdfs:comment "State, province or other first-level administrative region." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty core:stateProvinceCountry ; owl:someValuesFrom core:Country ] .
core:Country a owl:Class ; rdfs:label "Country" ; rdfs:comment "Country." ;
  skos:closeMatch schema:Country .
core:Currency a owl:Class ; rdfs:label "Currency" ; rdfs:comment "Currency in which leases, invoices and accounts are denominated." .
core:CalendarMonth a owl:Class ; rdfs:label "Calendar Month" ; rdfs:comment "Reporting and billing period. Charges, sales reports, occupancy snapshots and ledger entries are stated per month." .
core:PriceIndex a owl:Class ; rdfs:label "Price Index" ; rdfs:comment "Inflation index used to adjust rents, such as IGP-M or IPCA in Brazil or a consumer price index elsewhere." .
core:PriceIndexValue a owl:Class ; rdfs:label "Price Index Value" ; rdfs:comment "Published level and monthly change of a price index." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty core:priceIndexValuePriceIndex ; owl:someValuesFrom core:PriceIndex ] ,
    [ a owl:Restriction ; owl:onProperty core:priceIndexValueMonth ; owl:someValuesFrom core:CalendarMonth ] .
asset:Portfolio a owl:Class ; rdfs:label "Portfolio" ; rdfs:comment "Group of properties managed under one strategy or fund." .
asset:Property a owl:Class ; rdfs:label "Property" ; rdfs:comment "Shopping center or other managed real-estate asset. Gross leasable area (GLA, in Portuguese ABL) is the area available for lease to tenants." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:propertyPortfolio ; owl:someValuesFrom asset:Portfolio ] ,
    [ a owl:Restriction ; owl:onProperty asset:propertyAddress ; owl:someValuesFrom core:Address ] ,
    [ a owl:Restriction ; owl:onProperty asset:propertyCurrency ; owl:someValuesFrom core:Currency ] ;
  skos:closeMatch schema:ShoppingCenter .
asset:Building a owl:Class ; rdfs:label "Building" ; rdfs:comment "Structure within a property, such as the mall, an office tower or a parking building." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:buildingProperty ; owl:someValuesFrom asset:Property ] .
asset:Floor a owl:Class ; rdfs:label "Floor" ; rdfs:comment "Floor or level of a building." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:floorBuilding ; owl:someValuesFrom asset:Building ] .
asset:Zone a owl:Class ; rdfs:label "Zone" ; rdfs:comment "Wing, corridor or sector of a floor used to locate units and plan the tenant mix." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:zoneFloor ; owl:someValuesFrom asset:Floor ] .
asset:Space a owl:Class ; rdfs:label "Space" ; rdfs:comment "Abstract measured area of a property: leasable units, common areas or parking facilities." .
asset:LeasableUnit a owl:Class ; rdfs:label "Leasable Unit" ; rdfs:comment "Store, kiosk or other unit that counts towards gross leasable area and can be leased to a tenant." ;
  rdfs:subClassOf asset:Space ,
    [ a owl:Restriction ; owl:onProperty asset:leasableUnitZone ; owl:someValuesFrom asset:Zone ] ,
    [ a owl:Restriction ; owl:onProperty asset:leasableUnitUnitType ; owl:someValuesFrom asset:UnitType ] .
asset:UnitType a owl:Class ; rdfs:label "Unit Type" ; rdfs:comment "Classification of units: anchor, mega-store, inline store, kiosk, food court, restaurant, entertainment, services, office or storage." .
asset:CommonArea a owl:Class ; rdfs:label "Common Area" ; rdfs:comment "Shared area operated by the property: corridors, food-court seating, restrooms, loading docks and technical areas. Its costs are recovered through service charges." ;
  rdfs:subClassOf asset:Space ,
    [ a owl:Restriction ; owl:onProperty asset:commonAreaFloor ; owl:someValuesFrom asset:Floor ] .
asset:ParkingFacility a owl:Class ; rdfs:label "Parking Facility" ; rdfs:comment "Parking area of a property." ;
  rdfs:subClassOf asset:Space ,
    [ a owl:Restriction ; owl:onProperty asset:parkingFacilityProperty ; owl:someValuesFrom asset:Property ] .
asset:Entrance a owl:Class ; rdfs:label "Entrance" ; rdfs:comment "Visitor entrance where footfall is counted." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:entranceProperty ; owl:someValuesFrom asset:Property ] .
asset:AreaMeasurement a owl:Class ; rdfs:label "Area Measurement" ; rdfs:comment "Certified measurement of a unit area under a stated method." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:areaMeasurementUnit ; owl:someValuesFrom asset:LeasableUnit ] .
asset:OwnershipStake a owl:Class ; rdfs:label "Ownership Stake" ; rdfs:comment "Fractional ownership of a property by an investor. Shopping centers are often held in undivided shares by several investors." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:ownershipStakeInvestor ; owl:someValuesFrom party:Investor ] ,
    [ a owl:Restriction ; owl:onProperty asset:ownershipStakeProperty ; owl:someValuesFrom asset:Property ] .
asset:Valuation a owl:Class ; rdfs:label "Valuation" ; rdfs:comment "Appraisal of the market value of a property." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:valuationProperty ; owl:someValuesFrom asset:Property ] .
asset:Permit a owl:Class ; rdfs:label "Permit" ; rdfs:comment "Licence or certificate required to operate the property, such as an occupancy certificate, fire safety certificate or operating licence." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:permitProperty ; owl:someValuesFrom asset:Property ] .
asset:Equipment a owl:Class ; rdfs:label "Equipment" ; rdfs:comment "Maintained building equipment such as escalators, elevators, chillers, generators and fire pumps." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty asset:equipmentProperty ; owl:someValuesFrom asset:Property ] .
party:Tenant a owl:Class ; rdfs:label "Tenant" ; rdfs:comment "Role of an organization that leases space in a property: retailer, restaurant or service operator." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty party:tenantOrganization ; owl:someValuesFrom core:Organization ] .
party:Investor a owl:Class ; rdfs:label "Investor" ; rdfs:comment "Role of an organization or person that owns ownership stakes, such as a pension fund, real-estate fund, developer or individual." .
party:Broker a owl:Class ; rdfs:label "Broker" ; rdfs:comment "Role of a leasing broker or agency that introduces tenants." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty party:brokerOrganization ; owl:someValuesFrom core:Organization ] .
party:Brand a owl:Class ; rdfs:label "Brand" ; rdfs:comment "Commercial brand operated in a store. One tenant can operate several brands." ;
  skos:closeMatch schema:Brand .
party:MerchandiseCategory a owl:Class ; rdfs:label "Merchandise Category" ; rdfs:comment "Tenant-mix category, such as apparel, footwear, food court, services or entertainment. Categories form a hierarchy." .
party:TenantContact a owl:Class ; rdfs:label "Tenant Contact" ; rdfs:comment "Person a tenant designates for a responsibility, such as store manager, finance or legal." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty party:tenantContactPerson ; owl:someValuesFrom core:Person ] ,
    [ a owl:Restriction ; owl:onProperty party:tenantContactTenant ; owl:someValuesFrom party:Tenant ] .
lease:LeasingProspect a owl:Class ; rdfs:label "Leasing Prospect" ; rdfs:comment "Potential tenant in the leasing pipeline." .
lease:LeasingProposal a owl:Class ; rdfs:label "Leasing Proposal" ; rdfs:comment "Commercial offer or letter of intent for a unit." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:leasingProposalProspect ; owl:someValuesFrom lease:LeasingProspect ] ,
    [ a owl:Restriction ; owl:onProperty lease:leasingProposalUnit ; owl:someValuesFrom asset:LeasableUnit ] .
lease:LeaseStatus a owl:Class ; rdfs:label "Lease Status" ; rdfs:comment "Lifecycle state of a lease: pending signature, fit-out, active, holdover, in renewal proceedings, terminated or expired." .
lease:Lease a owl:Class ; rdfs:label "Lease" ; rdfs:comment "Commercial lease of one or more units to a tenant, registered as a contract. Shopping-center leases usually combine a monthly minimum rent with a percentage rent on gross sales, plus service charges and a marketing fund contribution." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:leaseContract ; owl:someValuesFrom legal:Contract ] ,
    [ a owl:Restriction ; owl:onProperty lease:leaseTenant ; owl:someValuesFrom party:Tenant ] ,
    [ a owl:Restriction ; owl:onProperty lease:leaseBrand ; owl:someValuesFrom party:Brand ] ,
    [ a owl:Restriction ; owl:onProperty lease:leaseStatus ; owl:someValuesFrom lease:LeaseStatus ] ,
    [ a owl:Restriction ; owl:onProperty lease:leasePermittedUse ; owl:someValuesFrom party:MerchandiseCategory ] ;
  skos:closeMatch schema:RentAction .
lease:LeasedUnit a owl:Class ; rdfs:label "Leased Unit" ; rdfs:comment "Unit covered by a lease for a period. A lease can cover several units and a unit is leased successively." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:leasedUnitLease ; owl:someValuesFrom lease:Lease ] ,
    [ a owl:Restriction ; owl:onProperty lease:leasedUnitUnit ; owl:someValuesFrom asset:LeasableUnit ] .
lease:RentStep a owl:Class ; rdfs:label "Rent Step" ; rdfs:comment "Step of the minimum-rent schedule, such as a discounted first year followed by full rent." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:rentStepLease ; owl:someValuesFrom lease:Lease ] .
lease:LeaseClause a owl:Class ; rdfs:label "Lease Clause" ; rdfs:comment "Abstract contractual clause of a lease." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:leaseClauseLease ; owl:someValuesFrom lease:Lease ] .
lease:PercentageRentClause a owl:Class ; rdfs:label "Percentage Rent Clause" ; rdfs:comment "Percentage rent: when the rate times monthly gross sales exceeds the minimum rent, the tenant pays the difference as overage rent." ;
  rdfs:subClassOf lease:LeaseClause .
lease:IndexationClause a owl:Class ; rdfs:label "Indexation Clause" ; rdfs:comment "Periodic adjustment of rent by a price index." ;
  rdfs:subClassOf lease:LeaseClause ,
    [ a owl:Restriction ; owl:onProperty lease:indexationClausePriceIndex ; owl:someValuesFrom core:PriceIndex ] .
lease:ExclusivityClause a owl:Class ; rdfs:label "Exclusivity Clause" ; rdfs:comment "Commitment by the landlord not to lease to competitors in a protected category." ;
  rdfs:subClassOf lease:LeaseClause ,
    [ a owl:Restriction ; owl:onProperty lease:exclusivityClauseProtectedCategory ; owl:someValuesFrom party:MerchandiseCategory ] .
lease:RadiusClause a owl:Class ; rdfs:label "Radius Clause" ; rdfs:comment "Restriction on the tenant opening another store within a radius of the property." ;
  rdfs:subClassOf lease:LeaseClause .
lease:CoTenancyClause a owl:Class ; rdfs:label "Co Tenancy Clause" ; rdfs:comment "Rent relief if required anchors close or occupancy falls below a threshold." ;
  rdfs:subClassOf lease:LeaseClause .
lease:RenewalOption a owl:Class ; rdfs:label "Renewal Option" ; rdfs:comment "Tenant option to renew the lease." ;
  rdfs:subClassOf lease:LeaseClause .
lease:EarlyTerminationOption a owl:Class ; rdfs:label "Early Termination Option" ; rdfs:comment "Right to end the lease early against a penalty." ;
  rdfs:subClassOf lease:LeaseClause .
lease:GuaranteeType a owl:Class ; rdfs:label "Guarantee Type" ; rdfs:comment "Kind of lease guarantee: surety bond, bank guarantee, security deposit, personal guarantor or rent-guarantee insurance." .
lease:Guarantee a owl:Class ; rdfs:label "Guarantee" ; rdfs:comment "Security provided for the obligations of a lease." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:guaranteeLease ; owl:someValuesFrom lease:Lease ] ,
    [ a owl:Restriction ; owl:onProperty lease:guaranteeGuaranteeType ; owl:someValuesFrom lease:GuaranteeType ] .
lease:KeyMoneyAgreement a owl:Class ; rdfs:label "Key Money Agreement" ; rdfs:comment "One-off fee for the right to use a location: a right-of-use fee (res sperata) in a new development or key money (luvas) for an existing location. It is not rent." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:keyMoneyAgreementLease ; owl:someValuesFrom lease:Lease ] .
lease:RentConcession a owl:Class ; rdfs:label "Rent Concession" ; rdfs:comment "Rent-free period, discount or deferral granted on a lease." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:rentConcessionLease ; owl:someValuesFrom lease:Lease ] .
lease:TenantAllowance a owl:Class ; rdfs:label "Tenant Allowance" ; rdfs:comment "Contribution by the landlord towards the tenant fit-out." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:tenantAllowanceLease ; owl:someValuesFrom lease:Lease ] .
lease:FitOutProject a owl:Class ; rdfs:label "Fit Out Project" ; rdfs:comment "Construction of the store by the tenant between handover and opening, subject to the landlord design approval." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:fitOutProjectLease ; owl:someValuesFrom lease:Lease ] ,
    [ a owl:Restriction ; owl:onProperty lease:fitOutProjectUnit ; owl:someValuesFrom asset:LeasableUnit ] .
lease:LeaseTermination a owl:Class ; rdfs:label "Lease Termination" ; rdfs:comment "End of a lease before or at expiry." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty lease:leaseTerminationLease ; owl:someValuesFrom lease:Lease ] .
legal:LegalEntity a owl:Class ; rdfs:label "Legal Entity" ; rdfs:comment "Role of an organization in the group that signs contracts, keeps books and employs staff: property-owning special-purpose company, fund, administrator or condominium." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:legalEntityOrganization ; owl:someValuesFrom core:Organization ] .
legal:ContractType a owl:Class ; rdfs:label "Contract Type" ; rdfs:comment "Kind of contract in the register: lease, service, supply framework, employment, loan, construction, insurance, brokerage, confidentiality or other." .
legal:Contract a owl:Class ; rdfs:label "Contract" ; rdfs:comment "Entry of the contract register. Every lease, service contract, supply agreement, employment contract, loan or construction contract is registered here with its number, term, value, parties, documents, obligations and approvals." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:contractContractType ; owl:someValuesFrom legal:ContractType ] ,
    [ a owl:Restriction ; owl:onProperty legal:contractContractingEntity ; owl:someValuesFrom legal:LegalEntity ] .
legal:ContractParty a owl:Class ; rdfs:label "Contract Party" ; rdfs:comment "Party to a contract other than the contracting entity: counterparty, guarantor, intervening party or witness." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:contractPartyContract ; owl:someValuesFrom legal:Contract ] .
legal:ContractDocument a owl:Class ; rdfs:label "Contract Document" ; rdfs:comment "Signed instrument or annex of a contract." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:contractDocumentContract ; owl:someValuesFrom legal:Contract ] .
legal:ContractAmendment a owl:Class ; rdfs:label "Contract Amendment" ; rdfs:comment "Signed change to a contract: price revision, extension, scope change, assignment or party change." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:contractAmendmentContract ; owl:someValuesFrom legal:Contract ] .
legal:ContractObligation a owl:Class ; rdfs:label "Contract Obligation" ; rdfs:comment "Obligation to monitor under a contract, such as payments, sales reporting, insurance certificates, opening hours, maintenance or renewal notices." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:contractObligationContract ; owl:someValuesFrom legal:Contract ] .
legal:ContractApproval a owl:Class ; rdfs:label "Contract Approval" ; rdfs:comment "Approval step of a contract under the delegation-of-authority matrix." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:contractApprovalContract ; owl:someValuesFrom legal:Contract ] ,
    [ a owl:Restriction ; owl:onProperty legal:contractApprovalApprover ; owl:someValuesFrom hr:Employee ] .
legal:PowerOfAttorney a owl:Class ; rdfs:label "Power Of Attorney" ; rdfs:comment "Authority granted by a legal entity to a person to sign or act on its behalf." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:powerOfAttorneyGrantor ; owl:someValuesFrom legal:LegalEntity ] ,
    [ a owl:Restriction ; owl:onProperty legal:powerOfAttorneyAttorney ; owl:someValuesFrom core:Person ] .
legal:GovernanceMeeting a owl:Class ; rdfs:label "Governance Meeting" ; rdfs:comment "Meeting of shareholders, board, investors, condominium assembly or tenants association." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:governanceMeetingLegalEntity ; owl:someValuesFrom legal:LegalEntity ] .
legal:Resolution a owl:Class ; rdfs:label "Resolution" ; rdfs:comment "Decision taken at a governance meeting, for example approving a budget, a capital project or a distribution." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:resolutionMeeting ; owl:someValuesFrom legal:GovernanceMeeting ] .
legal:LegalProceeding a owl:Class ; rdfs:label "Legal Proceeding" ; rdfs:comment "Lawsuit or administrative proceeding: eviction, lease renewal, rent review, collection, labour, tax or civil liability." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:legalProceedingLegalEntity ; owl:someValuesFrom legal:LegalEntity ] .
legal:LitigationProvision a owl:Class ; rdfs:label "Litigation Provision" ; rdfs:comment "Assessment of the loss probability of a proceeding and the amount provisioned in the accounts." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:litigationProvisionProceeding ; owl:someValuesFrom legal:LegalProceeding ] .
legal:ComplianceRequirement a owl:Class ; rdfs:label "Compliance Requirement" ; rdfs:comment "Recurring legal or regulatory requirement: fire safety, accessibility, environmental, sanitary, data protection or labour safety." .
legal:ComplianceCheck a owl:Class ; rdfs:label "Compliance Check" ; rdfs:comment "Verification of a requirement at a property." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:complianceCheckRequirement ; owl:someValuesFrom legal:ComplianceRequirement ] ,
    [ a owl:Restriction ; owl:onProperty legal:complianceCheckProperty ; owl:someValuesFrom asset:Property ] .
legal:DataSubjectRequest a owl:Class ; rdfs:label "Data Subject Request" ; rdfs:comment "Request by a person to access, correct, delete or port their personal data under data-protection law." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty legal:dataSubjectRequestDataSubject ; owl:someValuesFrom core:Person ] ,
    [ a owl:Restriction ; owl:onProperty legal:dataSubjectRequestController ; owl:someValuesFrom legal:LegalEntity ] .
hr:Department a owl:Class ; rdfs:label "Department" ; rdfs:comment "Organizational unit such as property operations, leasing, marketing, finance, legal or human resources." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:departmentLegalEntity ; owl:someValuesFrom legal:LegalEntity ] .
hr:Position a owl:Class ; rdfs:label "Position" ; rdfs:comment "Job position, such as general manager, leasing manager, maintenance technician or accounts payable analyst." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:positionDepartment ; owl:someValuesFrom hr:Department ] .
hr:Employee a owl:Class ; rdfs:label "Employee" ; rdfs:comment "Role of a person employed by a group legal entity." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:employeePerson ; owl:someValuesFrom core:Person ] ,
    [ a owl:Restriction ; owl:onProperty hr:employeePosition ; owl:someValuesFrom hr:Position ] ,
    [ a owl:Restriction ; owl:onProperty hr:employeeEmployer ; owl:someValuesFrom legal:LegalEntity ] .
hr:EmploymentContract a owl:Class ; rdfs:label "Employment Contract" ; rdfs:comment "Employment terms of an employee, registered as a contract." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:employmentContractEmployee ; owl:someValuesFrom hr:Employee ] ,
    [ a owl:Restriction ; owl:onProperty hr:employmentContractContract ; owl:someValuesFrom legal:Contract ] .
hr:CompensationChange a owl:Class ; rdfs:label "Compensation Change" ; rdfs:comment "Change of base salary by promotion, merit, collective agreement or correction." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:compensationChangeEmployee ; owl:someValuesFrom hr:Employee ] .
hr:PayrollRun a owl:Class ; rdfs:label "Payroll Run" ; rdfs:comment "Monthly payroll of a legal entity, including the thirteenth salary when due." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:payrollRunLegalEntity ; owl:someValuesFrom legal:LegalEntity ] ,
    [ a owl:Restriction ; owl:onProperty hr:payrollRunMonth ; owl:someValuesFrom core:CalendarMonth ] .
hr:PayrollLine a owl:Class ; rdfs:label "Payroll Line" ; rdfs:comment "Amount of one pay component for an employee in a payroll run. employer_cost is true for amounts borne by the employer (salary, overtime, benefits, employer social charges) and false for deductions withheld from the employee." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:payrollLinePayrollRun ; owl:someValuesFrom hr:PayrollRun ] ,
    [ a owl:Restriction ; owl:onProperty hr:payrollLineEmployee ; owl:someValuesFrom hr:Employee ] .
hr:TimeEntry a owl:Class ; rdfs:label "Time Entry" ; rdfs:comment "Hours recorded by an employee on a working day." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:timeEntryEmployee ; owl:someValuesFrom hr:Employee ] .
hr:LeaveRequest a owl:Class ; rdfs:label "Leave Request" ; rdfs:comment "Vacation, sick leave, parental leave or other absence." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:leaveRequestEmployee ; owl:someValuesFrom hr:Employee ] .
hr:Benefit a owl:Class ; rdfs:label "Benefit" ; rdfs:comment "Employee benefit such as health plan, dental plan, meal voucher, transport voucher or life insurance." .
hr:BenefitEnrollment a owl:Class ; rdfs:label "Benefit Enrollment" ; rdfs:comment "Enrollment of an employee in a benefit." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:benefitEnrollmentEmployee ; owl:someValuesFrom hr:Employee ] ,
    [ a owl:Restriction ; owl:onProperty hr:benefitEnrollmentBenefit ; owl:someValuesFrom hr:Benefit ] .
hr:TrainingCourse a owl:Class ; rdfs:label "Training Course" ; rdfs:comment "Training course, including mandatory safety training such as work at height, fire brigade or electrical safety." .
hr:TrainingRecord a owl:Class ; rdfs:label "Training Record" ; rdfs:comment "Completion of a course by an employee." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:trainingRecordEmployee ; owl:someValuesFrom hr:Employee ] ,
    [ a owl:Restriction ; owl:onProperty hr:trainingRecordCourse ; owl:someValuesFrom hr:TrainingCourse ] .
hr:PerformanceReview a owl:Class ; rdfs:label "Performance Review" ; rdfs:comment "Periodic performance evaluation." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:performanceReviewEmployee ; owl:someValuesFrom hr:Employee ] .
hr:JobOpening a owl:Class ; rdfs:label "Job Opening" ; rdfs:comment "Vacancy being recruited for a position." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:jobOpeningPosition ; owl:someValuesFrom hr:Position ] .
hr:JobApplication a owl:Class ; rdfs:label "Job Application" ; rdfs:comment "Application of a candidate to an opening." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty hr:jobApplicationJobOpening ; owl:someValuesFrom hr:JobOpening ] ,
    [ a owl:Restriction ; owl:onProperty hr:jobApplicationCandidate ; owl:someValuesFrom core:Person ] .
proc:Supplier a owl:Class ; rdfs:label "Supplier" ; rdfs:comment "Role of an organization that supplies goods or services: cleaning, security, maintenance, utilities, marketing, construction or professional services." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierOrganization ; owl:someValuesFrom core:Organization ] .
proc:SupplierQualification a owl:Class ; rdfs:label "Supplier Qualification" ; rdfs:comment "Onboarding check of a supplier: tax and labour certificates, insurance, references and compliance declarations." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierQualificationSupplier ; owl:someValuesFrom proc:Supplier ] .
proc:SupplierEvaluation a owl:Class ; rdfs:label "Supplier Evaluation" ; rdfs:comment "Periodic evaluation of supplier quality, timeliness and compliance." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierEvaluationSupplier ; owl:someValuesFrom proc:Supplier ] .
proc:SupplierAgreement a owl:Class ; rdfs:label "Supplier Agreement" ; rdfs:comment "Framework supply agreement with agreed prices and conditions, registered as a contract." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierAgreementContract ; owl:someValuesFrom legal:Contract ] ,
    [ a owl:Restriction ; owl:onProperty proc:supplierAgreementSupplier ; owl:someValuesFrom proc:Supplier ] .
proc:PurchaseRequisition a owl:Class ; rdfs:label "Purchase Requisition" ; rdfs:comment "Internal request to buy goods or services." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:purchaseRequisitionRequester ; owl:someValuesFrom hr:Employee ] .
proc:RequestForQuotation a owl:Class ; rdfs:label "Request For Quotation" ; rdfs:comment "Invitation to suppliers to quote for a requisition." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:requestForQuotationRequisition ; owl:someValuesFrom proc:PurchaseRequisition ] .
proc:SupplierQuote a owl:Class ; rdfs:label "Supplier Quote" ; rdfs:comment "Quote submitted by a supplier." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierQuoteRfq ; owl:someValuesFrom proc:RequestForQuotation ] ,
    [ a owl:Restriction ; owl:onProperty proc:supplierQuoteSupplier ; owl:someValuesFrom proc:Supplier ] .
proc:PurchaseOrder a owl:Class ; rdfs:label "Purchase Order" ; rdfs:comment "Order placed with a supplier." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:purchaseOrderSupplier ; owl:someValuesFrom proc:Supplier ] .
proc:PurchaseOrderLine a owl:Class ; rdfs:label "Purchase Order Line" ; rdfs:comment "Item or service ordered." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:purchaseOrderLinePurchaseOrder ; owl:someValuesFrom proc:PurchaseOrder ] ,
    [ a owl:Restriction ; owl:onProperty proc:purchaseOrderLineCategory ; owl:someValuesFrom ops:ExpenseCategory ] .
proc:GoodsReceipt a owl:Class ; rdfs:label "Goods Receipt" ; rdfs:comment "Receipt of goods or acceptance of services delivered under an order." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:goodsReceiptPurchaseOrder ; owl:someValuesFrom proc:PurchaseOrder ] .
proc:SupplierInvoice a owl:Class ; rdfs:label "Supplier Invoice" ; rdfs:comment "Supplier invoice payable, in Brazil an electronic fiscal document (NF-e or NFS-e). paid_amount holds payments at the reporting date." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierInvoiceSupplier ; owl:someValuesFrom proc:Supplier ] ,
    [ a owl:Restriction ; owl:onProperty proc:supplierInvoicePayer ; owl:someValuesFrom legal:LegalEntity ] ,
    [ a owl:Restriction ; owl:onProperty proc:supplierInvoiceMonth ; owl:someValuesFrom core:CalendarMonth ] .
proc:SupplierPayment a owl:Class ; rdfs:label "Supplier Payment" ; rdfs:comment "Payment of a supplier invoice." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty proc:supplierPaymentSupplierInvoice ; owl:someValuesFrom proc:SupplierInvoice ] .
ops:ExpenseCategory a owl:Class ; rdfs:label "Expense Category" ; rdfs:comment "Category of operating cost, such as cleaning, security, maintenance, utilities, insurance or administration fees." .
ops:ServiceChargeBudget a owl:Class ; rdfs:label "Service Charge Budget" ; rdfs:comment "Annual budget of shared operating costs recovered from tenants (in Brazil, the condominium budget)." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:serviceChargeBudgetProperty ; owl:someValuesFrom asset:Property ] .
ops:ServiceChargeBudgetLine a owl:Class ; rdfs:label "Service Charge Budget Line" ; rdfs:comment "Budgeted amount for one expense category." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:serviceChargeBudgetLineBudget ; owl:someValuesFrom ops:ServiceChargeBudget ] ,
    [ a owl:Restriction ; owl:onProperty ops:serviceChargeBudgetLineCategory ; owl:someValuesFrom ops:ExpenseCategory ] .
ops:AllocationKey a owl:Class ; rdfs:label "Allocation Key" ; rdfs:comment "Rule to apportion recoverable costs among units, by area, ideal fraction, metered consumption or fixed share." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:allocationKeyProperty ; owl:someValuesFrom asset:Property ] .
ops:AllocationShare a owl:Class ; rdfs:label "Allocation Share" ; rdfs:comment "Share of a unit under an allocation key." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:allocationShareAllocationKey ; owl:someValuesFrom ops:AllocationKey ] ,
    [ a owl:Restriction ; owl:onProperty ops:allocationShareUnit ; owl:someValuesFrom asset:LeasableUnit ] .
ops:ServiceContract a owl:Class ; rdfs:label "Service Contract" ; rdfs:comment "Recurring service contract at a property, such as cleaning, security, maintenance, parking operation or landscaping, registered as a contract." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:serviceContractContract ; owl:someValuesFrom legal:Contract ] ,
    [ a owl:Restriction ; owl:onProperty ops:serviceContractSupplier ; owl:someValuesFrom proc:Supplier ] ,
    [ a owl:Restriction ; owl:onProperty ops:serviceContractProperty ; owl:someValuesFrom asset:Property ] ,
    [ a owl:Restriction ; owl:onProperty ops:serviceContractCategory ; owl:someValuesFrom ops:ExpenseCategory ] .
ops:OperatingExpense a owl:Class ; rdfs:label "Operating Expense" ; rdfs:comment "Actual operating cost incurred by a property in a month." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:operatingExpenseProperty ; owl:someValuesFrom asset:Property ] ,
    [ a owl:Restriction ; owl:onProperty ops:operatingExpenseCategory ; owl:someValuesFrom ops:ExpenseCategory ] ,
    [ a owl:Restriction ; owl:onProperty ops:operatingExpenseMonth ; owl:someValuesFrom core:CalendarMonth ] .
ops:WorkOrder a owl:Class ; rdfs:label "Work Order" ; rdfs:comment "Maintenance request or task: corrective, preventive or requested by a tenant." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:workOrderProperty ; owl:someValuesFrom asset:Property ] .
ops:UtilityType a owl:Class ; rdfs:label "Utility Type" ; rdfs:comment "Metered utility: electricity, water, gas or chilled water." .
ops:UtilityMeter a owl:Class ; rdfs:label "Utility Meter" ; rdfs:comment "Meter measuring consumption of a utility by a unit or common installation." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:utilityMeterUtilityType ; owl:someValuesFrom ops:UtilityType ] ,
    [ a owl:Restriction ; owl:onProperty ops:utilityMeterProperty ; owl:someValuesFrom asset:Property ] .
ops:MeterReading a owl:Class ; rdfs:label "Meter Reading" ; rdfs:comment "Reading of a meter, the basis for recharging consumption to tenants." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:meterReadingMeter ; owl:someValuesFrom ops:UtilityMeter ] ,
    [ a owl:Restriction ; owl:onProperty ops:meterReadingMonth ; owl:someValuesFrom core:CalendarMonth ] .
ops:InsurancePolicy a owl:Class ; rdfs:label "Insurance Policy" ; rdfs:comment "Insurance covering the property, such as property damage, loss of rent or civil liability." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:insurancePolicyProperty ; owl:someValuesFrom asset:Property ] ,
    [ a owl:Restriction ; owl:onProperty ops:insurancePolicyInsurer ; owl:someValuesFrom core:Organization ] .
ops:Incident a owl:Class ; rdfs:label "Incident" ; rdfs:comment "Safety, security or operational incident at a property." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:incidentProperty ; owl:someValuesFrom asset:Property ] .
ops:MarketingFund a owl:Class ; rdfs:label "Marketing Fund" ; rdfs:comment "Annual promotion and advertising fund financed by tenant contributions, usually a fraction of minimum rent." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:marketingFundProperty ; owl:someValuesFrom asset:Property ] .
ops:MarketingCampaign a owl:Class ; rdfs:label "Marketing Campaign" ; rdfs:comment "Campaign financed by the marketing fund." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:marketingCampaignFund ; owl:someValuesFrom ops:MarketingFund ] .
ops:MallEvent a owl:Class ; rdfs:label "Mall Event" ; rdfs:comment "Event held at a property to attract visitors." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ops:mallEventProperty ; owl:someValuesFrom asset:Property ] ;
  skos:closeMatch schema:Event .
fin:ChargeType a owl:Class ; rdfs:label "Charge Type" ; rdfs:comment "Kind of billed item: minimum rent, percentage (overage) rent, thirteenth rent, service charge, marketing fund, utility recharge, key-money instalment or late fee." .
fin:Invoice a owl:Class ; rdfs:label "Invoice" ; rdfs:comment "Billing document issued by a property to a tenant, payable by bank slip, transfer or instant payment." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:invoiceProperty ; owl:someValuesFrom asset:Property ] ,
    [ a owl:Restriction ; owl:onProperty fin:invoiceBilledTenant ; owl:someValuesFrom party:Tenant ] ;
  skos:closeMatch schema:Invoice .
fin:Charge a owl:Class ; rdfs:label "Charge" ; rdfs:comment "Billed amount of one charge type for a lease and competence month. paid_amount holds the allocated payments at the reporting date." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:chargeInvoice ; owl:someValuesFrom fin:Invoice ] ,
    [ a owl:Restriction ; owl:onProperty fin:chargeLease ; owl:someValuesFrom lease:Lease ] ,
    [ a owl:Restriction ; owl:onProperty fin:chargeChargeType ; owl:someValuesFrom fin:ChargeType ] ,
    [ a owl:Restriction ; owl:onProperty fin:chargeMonth ; owl:someValuesFrom core:CalendarMonth ] .
fin:BankAccount a owl:Class ; rdfs:label "Bank Account" ; rdfs:comment "Bank account used for collections, supplier payments, payroll and distributions." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:bankAccountHolder ; owl:someValuesFrom legal:LegalEntity ] .
fin:Payment a owl:Class ; rdfs:label "Payment" ; rdfs:comment "Payment received from a tenant." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:paymentPayer ; owl:someValuesFrom party:Tenant ] ;
  skos:closeMatch schema:PayAction .
fin:PaymentAllocation a owl:Class ; rdfs:label "Payment Allocation" ; rdfs:comment "Part of a payment applied to a charge." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:paymentAllocationPayment ; owl:someValuesFrom fin:Payment ] ,
    [ a owl:Restriction ; owl:onProperty fin:paymentAllocationCharge ; owl:someValuesFrom fin:Charge ] .
fin:ArrearsCase a owl:Class ; rdfs:label "Arrears Case" ; rdfs:comment "Delinquency case opened when a lease has overdue charges." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:arrearsCaseLease ; owl:someValuesFrom lease:Lease ] .
fin:CollectionAction a owl:Class ; rdfs:label "Collection Action" ; rdfs:comment "Step taken to collect overdue amounts: reminder, formal notice, protest, agreement or lawsuit." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:collectionActionArrearsCase ; owl:someValuesFrom fin:ArrearsCase ] .
fin:PaymentAgreement a owl:Class ; rdfs:label "Payment Agreement" ; rdfs:comment "Agreement to settle overdue amounts in instalments." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:paymentAgreementArrearsCase ; owl:someValuesFrom fin:ArrearsCase ] .
fin:LedgerAccount a owl:Class ; rdfs:label "Ledger Account" ; rdfs:comment "Account of the property chart of accounts." .
fin:JournalEntry a owl:Class ; rdfs:label "Journal Entry" ; rdfs:comment "Accounting entry of a legal entity for a month." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:journalEntryLegalEntity ; owl:someValuesFrom legal:LegalEntity ] ,
    [ a owl:Restriction ; owl:onProperty fin:journalEntryMonth ; owl:someValuesFrom core:CalendarMonth ] .
fin:JournalLine a owl:Class ; rdfs:label "Journal Line" ; rdfs:comment "Signed amount posted to a ledger account and cost center: income is positive and expense negative. noi_class is fixed at posting from the account: revenue, opex or excluded." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:journalLineEntry ; owl:someValuesFrom fin:JournalEntry ] ,
    [ a owl:Restriction ; owl:onProperty fin:journalLineAccount ; owl:someValuesFrom fin:LedgerAccount ] ,
    [ a owl:Restriction ; owl:onProperty fin:journalLineCostCenter ; owl:someValuesFrom fin:CostCenter ] .
fin:OwnerDistribution a owl:Class ; rdfs:label "Owner Distribution" ; rdfs:comment "Cash distributed to an investor for its ownership stake." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:ownerDistributionStake ; owl:someValuesFrom asset:OwnershipStake ] ,
    [ a owl:Restriction ; owl:onProperty fin:ownerDistributionMonth ; owl:someValuesFrom core:CalendarMonth ] .
fin:CapitalProject a owl:Class ; rdfs:label "Capital Project" ; rdfs:comment "Capital expenditure on a property: expansion, renovation, retrofit or sustainability works." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:capitalProjectProperty ; owl:someValuesFrom asset:Property ] .
fin:CostCenter a owl:Class ; rdfs:label "Cost Center" ; rdfs:comment "Unit of cost and result responsibility: a property, a department or a corporate function." .
fin:OperatingBudget a owl:Class ; rdfs:label "Operating Budget" ; rdfs:comment "Approved annual budget of a legal entity, by version." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:operatingBudgetLegalEntity ; owl:someValuesFrom legal:LegalEntity ] .
fin:BudgetLine a owl:Class ; rdfs:label "Budget Line" ; rdfs:comment "Budgeted amount for an account, cost center and month." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:budgetLineBudget ; owl:someValuesFrom fin:OperatingBudget ] ,
    [ a owl:Restriction ; owl:onProperty fin:budgetLineAccount ; owl:someValuesFrom fin:LedgerAccount ] ,
    [ a owl:Restriction ; owl:onProperty fin:budgetLineCostCenter ; owl:someValuesFrom fin:CostCenter ] ,
    [ a owl:Restriction ; owl:onProperty fin:budgetLineMonth ; owl:someValuesFrom core:CalendarMonth ] .
fin:TaxType a owl:Class ; rdfs:label "Tax Type" ; rdfs:comment "Tax or levy, such as property tax (IPTU), services tax (ISS), PIS, COFINS, income taxes or social security." .
fin:TaxObligation a owl:Class ; rdfs:label "Tax Obligation" ; rdfs:comment "Tax assessed or declared for a period, such as annual property tax instalments or monthly taxes on revenue." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:taxObligationTaxType ; owl:someValuesFrom fin:TaxType ] ,
    [ a owl:Restriction ; owl:onProperty fin:taxObligationLegalEntity ; owl:someValuesFrom legal:LegalEntity ] ,
    [ a owl:Restriction ; owl:onProperty fin:taxObligationMonth ; owl:someValuesFrom core:CalendarMonth ] .
fin:TaxWithholding a owl:Class ; rdfs:label "Tax Withholding" ; rdfs:comment "Tax withheld from a supplier invoice and paid to the authority on the supplier behalf." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:taxWithholdingSupplierInvoice ; owl:someValuesFrom proc:SupplierInvoice ] ,
    [ a owl:Restriction ; owl:onProperty fin:taxWithholdingTaxType ; owl:someValuesFrom fin:TaxType ] .
fin:FixedAsset a owl:Class ; rdfs:label "Fixed Asset" ; rdfs:comment "Capitalised asset: building, improvement, equipment or furniture." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:fixedAssetProperty ; owl:someValuesFrom asset:Property ] .
fin:DepreciationEntry a owl:Class ; rdfs:label "Depreciation Entry" ; rdfs:comment "Monthly depreciation of a fixed asset." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:depreciationEntryFixedAsset ; owl:someValuesFrom fin:FixedAsset ] ,
    [ a owl:Restriction ; owl:onProperty fin:depreciationEntryMonth ; owl:someValuesFrom core:CalendarMonth ] .
fin:LoanAgreement a owl:Class ; rdfs:label "Loan Agreement" ; rdfs:comment "Debt financing, such as a bank loan or real-estate receivables securitisation, registered as a contract." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:loanAgreementContract ; owl:someValuesFrom legal:Contract ] ,
    [ a owl:Restriction ; owl:onProperty fin:loanAgreementLender ; owl:someValuesFrom core:Organization ] ,
    [ a owl:Restriction ; owl:onProperty fin:loanAgreementBorrower ; owl:someValuesFrom legal:LegalEntity ] .
fin:DebtServicePayment a owl:Class ; rdfs:label "Debt Service Payment" ; rdfs:comment "Scheduled or paid instalment of principal and interest." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:debtServicePaymentLoan ; owl:someValuesFrom fin:LoanAgreement ] .
fin:BankTransaction a owl:Class ; rdfs:label "Bank Transaction" ; rdfs:comment "Statement line of a bank account, reconciled against receipts and payments." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:bankTransactionBankAccount ; owl:someValuesFrom fin:BankAccount ] .
fin:InsuranceClaim a owl:Class ; rdfs:label "Insurance Claim" ; rdfs:comment "Claim under an insurance policy." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty fin:insuranceClaimPolicy ; owl:someValuesFrom ops:InsurancePolicy ] .
perf:OccupancySnapshot a owl:Class ; rdfs:label "Occupancy Snapshot" ; rdfs:comment "State of a unit at month end: its gross leasable area, the area occupied under a lease and the contracted minimum rent. One row per unit and month." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty perf:occupancySnapshotUnit ; owl:someValuesFrom asset:LeasableUnit ] ,
    [ a owl:Restriction ; owl:onProperty perf:occupancySnapshotMonth ; owl:someValuesFrom core:CalendarMonth ] .
perf:SalesReport a owl:Class ; rdfs:label "Sales Report" ; rdfs:comment "Monthly gross sales declared by a tenant, the basis for percentage rent. occupancy_cost is the rent, service charge and marketing fund billed for the same month." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty perf:salesReportLease ; owl:someValuesFrom lease:Lease ] ,
    [ a owl:Restriction ; owl:onProperty perf:salesReportProperty ; owl:someValuesFrom asset:Property ] ,
    [ a owl:Restriction ; owl:onProperty perf:salesReportMonth ; owl:someValuesFrom core:CalendarMonth ] .
perf:SalesAudit a owl:Class ; rdfs:label "Sales Audit" ; rdfs:comment "Audit of declared sales against tenant records." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty perf:salesAuditSalesReport ; owl:someValuesFrom perf:SalesReport ] .
perf:FootfallCount a owl:Class ; rdfs:label "Footfall Count" ; rdfs:comment "Visitors counted at an entrance over a counting period." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty perf:footfallCountEntrance ; owl:someValuesFrom asset:Entrance ] ,
    [ a owl:Restriction ; owl:onProperty perf:footfallCountMonth ; owl:someValuesFrom core:CalendarMonth ] .
perf:ParkingActivity a owl:Class ; rdfs:label "Parking Activity" ; rdfs:comment "Tickets and revenue of a parking facility in a month." ;
  rdfs:subClassOf [ a owl:Restriction ; owl:onProperty perf:parkingActivityFacility ; owl:someValuesFrom asset:ParkingFacility ] ,
    [ a owl:Restriction ; owl:onProperty perf:parkingActivityMonth ; owl:someValuesFrom core:CalendarMonth ] .
[] a owl:AllDisjointClasses ; owl:members ( core:Organization core:Person ) .
[] a owl:AllDisjointClasses ; owl:members ( asset:LeasableUnit asset:CommonArea asset:ParkingFacility ) .
[] a owl:AllDisjointClasses ; owl:members ( lease:PercentageRentClause lease:IndexationClause lease:ExclusivityClause lease:RadiusClause lease:CoTenancyClause lease:RenewalOption lease:EarlyTerminationOption ) .

core:partyAddress a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "address" ; rdfs:comment "Registered or correspondence address." ; rdfs:domain core:Party ; rdfs:range core:Address .
core:partyName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "name" ; rdfs:comment "Name used in day-to-day administration." ; rdfs:domain core:Party ; rdfs:range xsd:string .
core:partyLegalName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "legal name" ; rdfs:comment "Registered legal name." ; rdfs:domain core:Party ; rdfs:range xsd:string .
core:partyTaxId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "tax id" ; rdfs:comment "Tax registration number." ; rdfs:domain core:Party ; rdfs:range xsd:string .
core:partyEmail a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "email" ; rdfs:comment "Main email address." ; rdfs:domain core:Party ; rdfs:range xsd:string .
core:partyPhone a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "phone" ; rdfs:comment "Main phone number." ; rdfs:domain core:Party ; rdfs:range xsd:string .
core:organizationParentOrganization a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "parent organization" ; rdfs:comment "Economic group or parent company." ; rdfs:domain core:Organization ; rdfs:range core:Organization .
core:organizationOrganizationType a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "organization type" ; rdfs:comment "Kind of organization, for example company, fund, bank, insurer, authority, court or law firm." ; rdfs:domain core:Organization ; rdfs:range xsd:string .
core:organizationLegalForm a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "legal form" ; rdfs:comment "Legal form, for example limited company, corporation, investment fund or association." ; rdfs:domain core:Organization ; rdfs:range xsd:string .
core:personBirthDate a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "birth date" ; rdfs:comment "Date of birth." ; rdfs:domain core:Person ; rdfs:range xsd:date .
core:personNationality a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "nationality" ; rdfs:comment "Nationality." ; rdfs:domain core:Person ; rdfs:range xsd:string .
core:addressCity a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "city" ; rdfs:comment "City of the address." ; rdfs:domain core:Address ; rdfs:range core:City .
core:addressStreet a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "street" ; rdfs:comment "Street name." ; rdfs:domain core:Address ; rdfs:range xsd:string .
core:addressStreetNumber a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "street number" ; rdfs:comment "Street number." ; rdfs:domain core:Address ; rdfs:range xsd:string .
core:addressComplement a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "complement" ; rdfs:comment "Additional address detail." ; rdfs:domain core:Address ; rdfs:range xsd:string .
core:addressDistrict a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "district" ; rdfs:comment "District or neighbourhood." ; rdfs:domain core:Address ; rdfs:range xsd:string .
core:addressPostalCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "postal code" ; rdfs:comment "Postal code." ; rdfs:domain core:Address ; rdfs:range xsd:string .
core:cityState a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "state" ; rdfs:comment "State or province of the city." ; rdfs:domain core:City ; rdfs:range core:StateProvince .
core:cityName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "name" ; rdfs:comment "City name." ; rdfs:domain core:City ; rdfs:range xsd:string .
core:stateProvinceCountry a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:label "country" ; rdfs:comment "Country of the region." ; rdfs:domain core:StateProvince ; rdfs:range core:Country .
core:stateProvinceName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "name" ; rdfs:comment "State name." ; rdfs:domain core:StateProvince ; rdfs:range xsd:string .
core:stateProvinceCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "code" ; rdfs:comment "Abbreviation." ; rdfs:domain core:StateProvince ; rdfs:range xsd:string .
core:countryName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:label "name" ; rdfs:comment "Country name." ; rdfs:domain core:Country ; rdfs:range xsd:string .
