@prefix core: <https://example.org/mall/core#> .
@prefix asset: <https://example.org/mall/asset#> .
@prefix party: <https://example.org/mall/party#> .
@prefix lease: <https://example.org/mall/lease#> .
@prefix ops: <https://example.org/mall/ops#> .
@prefix fin: <https://example.org/mall/fin#> .
@prefix perf: <https://example.org/mall/perf#> .
@prefix kpi: <https://example.org/mall/kpi#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
core:PartyShape a sh:NodeShape ; rdfs:label "Party requirements" ; sh:targetClass core:Party ;
  sh:property [ sh:path core:partyName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:partyLegalName ; sh:name "legal name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:partyTaxId ; sh:name "tax id" ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path core:partyEmail ; sh:name "email" ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path core:partyPhone ; sh:name "phone" ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path core:partyAddress ; sh:name "address" ; sh:class core:Address ; sh:maxCount 1 ] .
core:OrganizationShape a sh:NodeShape ; rdfs:label "Organization requirements" ; sh:targetClass core:Organization ;
  sh:property [ sh:path core:organizationOrganizationType ; sh:name "organization type" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:organizationParentOrganization ; sh:name "parent organization" ; sh:class core:Organization ; sh:maxCount 1 ] .
core:PersonShape a sh:NodeShape ; rdfs:label "Person requirements" ; sh:targetClass core:Person ;
  sh:property [ sh:path core:personJobTitle ; sh:name "job title" ; sh:datatype xsd:string ; sh:maxCount 1 ] .
core:AddressShape a sh:NodeShape ; rdfs:label "Address requirements" ; sh:targetClass core:Address ;
  sh:property [ sh:path core:addressStreet ; sh:name "street" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path core:addressStreetNumber ; sh:name "street number" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:addressComplement ; sh:name "complement" ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path core:addressDistrict ; sh:name "district" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:addressPostalCode ; sh:name "postal code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:addressCity ; sh:name "city" ; sh:class core:City ; sh:maxCount 1 ; sh:minCount 1 ] .
core:CityShape a sh:NodeShape ; rdfs:label "City requirements" ; sh:targetClass core:City ;
  sh:property [ sh:path core:cityName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:cityState ; sh:name "state" ; sh:class core:StateProvince ; sh:maxCount 1 ; sh:minCount 1 ] .
core:StateProvinceShape a sh:NodeShape ; rdfs:label "State Province requirements" ; sh:targetClass core:StateProvince ;
  sh:property [ sh:path core:stateProvinceName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:stateProvinceCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:stateProvinceCountry ; sh:name "country" ; sh:class core:Country ; sh:maxCount 1 ; sh:minCount 1 ] .
core:CountryShape a sh:NodeShape ; rdfs:label "Country requirements" ; sh:targetClass core:Country ;
  sh:property [ sh:path core:countryName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:countryIsoCode ; sh:name "iso code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] .
core:CurrencyShape a sh:NodeShape ; rdfs:label "Currency requirements" ; sh:targetClass core:Currency ;
  sh:property [ sh:path core:currencyName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:currencyIsoCode ; sh:name "iso code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] .
core:CalendarMonthShape a sh:NodeShape ; rdfs:label "Calendar Month requirements" ; sh:targetClass core:CalendarMonth ;
  sh:property [ sh:path core:calendarMonthYearMonth ; sh:name "year month" ; sh:datatype xsd:gYearMonth ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path core:calendarMonthYear ; sh:name "year" ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path core:calendarMonthMonthNumber ; sh:name "month number" ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path core:calendarMonthQuarter ; sh:name "quarter" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] .
core:PriceIndexShape a sh:NodeShape ; rdfs:label "Price Index requirements" ; sh:targetClass core:PriceIndex ;
  sh:property [ sh:path core:priceIndexName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:priceIndexCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path core:priceIndexPublisher ; sh:name "publisher" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] .
core:PriceIndexValueShape a sh:NodeShape ; rdfs:label "Price Index Value requirements" ; sh:targetClass core:PriceIndexValue ;
  sh:property [ sh:path core:priceIndexValueIndexLevel ; sh:name "index level" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path core:priceIndexValueMonthlyChange ; sh:name "monthly change" ; sh:datatype xsd:decimal ; sh:maxCount 1 ] ,
    [ sh:path core:priceIndexValuePriceIndex ; sh:name "price index" ; sh:class core:PriceIndex ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path core:priceIndexValueMonth ; sh:name "month" ; sh:class core:CalendarMonth ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:PortfolioShape a sh:NodeShape ; rdfs:label "Portfolio requirements" ; sh:targetClass asset:Portfolio ;
  sh:property [ sh:path asset:portfolioName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:portfolioStrategy ; sh:name "strategy" ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path asset:portfolioAssetManager ; sh:name "asset manager" ; sh:class core:Organization ; sh:maxCount 1 ] .
asset:PropertyShape a sh:NodeShape ; rdfs:label "Property requirements" ; sh:targetClass asset:Property ;
  sh:property [ sh:path asset:propertyCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:propertyName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:propertyPropertyFormat ; sh:name "property format" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:propertyOpeningDate ; sh:name "opening date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path asset:propertyTotalGlaM2 ; sh:name "total gla m2" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:propertyGrossBuiltAreaM2 ; sh:name "gross built area m2" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:propertyParkingSpaces ; sh:name "parking spaces" ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:propertyPortfolio ; sh:name "portfolio" ; sh:class asset:Portfolio ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:propertyAddress ; sh:name "address" ; sh:class core:Address ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:propertyCurrency ; sh:name "currency" ; sh:class core:Currency ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:propertyAdministrator ; sh:name "administrator" ; sh:class core:Organization ; sh:maxCount 1 ] ,
    [ sh:path asset:propertyGeneralManager ; sh:name "general manager" ; sh:class core:Person ; sh:maxCount 1 ] .
asset:BuildingShape a sh:NodeShape ; rdfs:label "Building requirements" ; sh:targetClass asset:Building ;
  sh:property [ sh:path asset:buildingCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:buildingName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:buildingBuiltYear ; sh:name "built year" ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
    [ sh:path asset:buildingProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:FloorShape a sh:NodeShape ; rdfs:label "Floor requirements" ; sh:targetClass asset:Floor ;
  sh:property [ sh:path asset:floorCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:floorName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:floorLevelNumber ; sh:name "level number" ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
    [ sh:path asset:floorBuilding ; sh:name "building" ; sh:class asset:Building ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:ZoneShape a sh:NodeShape ; rdfs:label "Zone requirements" ; sh:targetClass asset:Zone ;
  sh:property [ sh:path asset:zoneCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:zoneName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:zoneFloor ; sh:name "floor" ; sh:class asset:Floor ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:SpaceShape a sh:NodeShape ; rdfs:label "Space requirements" ; sh:targetClass asset:Space ;
  sh:property [ sh:path asset:spaceCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:spaceName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:spaceAreaM2 ; sh:name "area m2" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ] .
asset:LeasableUnitShape a sh:NodeShape ; rdfs:label "Leasable Unit requirements" ; sh:targetClass asset:LeasableUnit ;
  sh:property [ sh:path asset:leasableUnitFrontageM ; sh:name "frontage m" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:leasableUnitHasMezzanine ; sh:name "has mezzanine" ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
    [ sh:path asset:leasableUnitZone ; sh:name "zone" ; sh:class asset:Zone ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:leasableUnitUnitType ; sh:name "unit type" ; sh:class asset:UnitType ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:UnitTypeShape a sh:NodeShape ; rdfs:label "Unit Type requirements" ; sh:targetClass asset:UnitType ;
  sh:property [ sh:path asset:unitTypeCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:unitTypeName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:unitTypeCountsAsGla ; sh:name "counts as gla" ; sh:datatype xsd:boolean ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:CommonAreaShape a sh:NodeShape ; rdfs:label "Common Area requirements" ; sh:targetClass asset:CommonArea ;
  sh:property [ sh:path asset:commonAreaAreaKind ; sh:name "area kind" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:commonAreaFloor ; sh:name "floor" ; sh:class asset:Floor ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:ParkingFacilityShape a sh:NodeShape ; rdfs:label "Parking Facility requirements" ; sh:targetClass asset:ParkingFacility ;
  sh:property [ sh:path asset:parkingFacilityCapacity ; sh:name "capacity" ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:parkingFacilityIsPaid ; sh:name "is paid" ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
    [ sh:path asset:parkingFacilityProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:EntranceShape a sh:NodeShape ; rdfs:label "Entrance requirements" ; sh:targetClass asset:Entrance ;
  sh:property [ sh:path asset:entranceCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:entranceName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:entranceEntranceKind ; sh:name "entrance kind" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:entranceProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:AreaMeasurementShape a sh:NodeShape ; rdfs:label "Area Measurement requirements" ; sh:targetClass asset:AreaMeasurement ;
  sh:property [ sh:path asset:areaMeasurementMeasurementDate ; sh:name "measurement date" ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:areaMeasurementMeasuredAreaM2 ; sh:name "measured area m2" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:areaMeasurementMethod ; sh:name "method" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:areaMeasurementUnit ; sh:name "unit" ; sh:class asset:LeasableUnit ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:areaMeasurementSurveyor ; sh:name "surveyor" ; sh:class core:Organization ; sh:maxCount 1 ] .
asset:OwnershipStakeShape a sh:NodeShape ; rdfs:label "Ownership Stake requirements" ; sh:targetClass asset:OwnershipStake ;
  sh:property [ sh:path asset:ownershipStakeShare ; sh:name "share" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ,
    [ sh:path asset:ownershipStakeStartDate ; sh:name "start date" ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:minCount 1 ; sh:lessThanOrEquals asset:ownershipStakeEndDate ] ,
    [ sh:path asset:ownershipStakeEndDate ; sh:name "end date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path asset:ownershipStakeInvestor ; sh:name "investor" ; sh:class party:Investor ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:ownershipStakeProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] .
asset:ValuationShape a sh:NodeShape ; rdfs:label "Valuation requirements" ; sh:targetClass asset:Valuation ;
  sh:property [ sh:path asset:valuationValuationDate ; sh:name "valuation date" ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:valuationMarketValue ; sh:name "market value" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path asset:valuationCapitalizationRate ; sh:name "capitalization rate" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ,
    [ sh:path asset:valuationDiscountRate ; sh:name "discount rate" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ,
    [ sh:path asset:valuationProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:valuationAppraiser ; sh:name "appraiser" ; sh:class core:Organization ; sh:maxCount 1 ] .
asset:PermitShape a sh:NodeShape ; rdfs:label "Permit requirements" ; sh:targetClass asset:Permit ;
  sh:property [ sh:path asset:permitPermitNumber ; sh:name "permit number" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:permitPermitType ; sh:name "permit type" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:permitIssueDate ; sh:name "issue date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path asset:permitExpiryDate ; sh:name "expiry date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path asset:permitProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path asset:permitIssuer ; sh:name "issuer" ; sh:class core:Organization ; sh:maxCount 1 ] .
asset:EquipmentShape a sh:NodeShape ; rdfs:label "Equipment requirements" ; sh:targetClass asset:Equipment ;
  sh:property [ sh:path asset:equipmentTag ; sh:name "tag" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:equipmentName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:equipmentEquipmentType ; sh:name "equipment type" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:equipmentInstallDate ; sh:name "install date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path asset:equipmentManufacturer ; sh:name "manufacturer" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path asset:equipmentProperty ; sh:name "property" ; sh:class asset:Property ; sh:maxCount 1 ; sh:minCount 1 ] .
party:TenantShape a sh:NodeShape ; rdfs:label "Tenant requirements" ; sh:targetClass party:Tenant ;
  sh:property [ sh:path party:tenantTradeName ; sh:name "trade name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] .
party:InvestorShape a sh:NodeShape ; rdfs:label "Investor requirements" ; sh:targetClass party:Investor ;
  sh:property [ sh:path party:investorInvestorType ; sh:name "investor type" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] .
party:ServiceProviderShape a sh:NodeShape ; rdfs:label "Service Provider requirements" ; sh:targetClass party:ServiceProvider ;
  sh:property [ sh:path party:serviceProviderServiceCategory ; sh:name "service category" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] .
party:BrokerShape a sh:NodeShape ; rdfs:label "Broker requirements" ; sh:targetClass party:Broker ;
  sh:property [ sh:path party:brokerLicenseNumber ; sh:name "license number" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] .
party:BrandShape a sh:NodeShape ; rdfs:label "Brand requirements" ; sh:targetClass party:Brand ;
  sh:property [ sh:path party:brandName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path party:brandOwner ; sh:name "owner" ; sh:class party:Tenant ; sh:maxCount 1 ] .
party:MerchandiseCategoryShape a sh:NodeShape ; rdfs:label "Merchandise Category requirements" ; sh:targetClass party:MerchandiseCategory ;
  sh:property [ sh:path party:merchandiseCategoryCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path party:merchandiseCategoryName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path party:merchandiseCategoryParentCategory ; sh:name "parent category" ; sh:class party:MerchandiseCategory ; sh:maxCount 1 ] .
party:TenantContactShape a sh:NodeShape ; rdfs:label "Tenant Contact requirements" ; sh:targetClass party:TenantContact ;
  sh:property [ sh:path party:tenantContactRole ; sh:name "role" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path party:tenantContactIsPrimary ; sh:name "is primary" ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
    [ sh:path party:tenantContactPerson ; sh:name "person" ; sh:class core:Person ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path party:tenantContactTenant ; sh:name "tenant" ; sh:class party:Tenant ; sh:maxCount 1 ; sh:minCount 1 ] .
lease:LeasingProspectShape a sh:NodeShape ; rdfs:label "Leasing Prospect requirements" ; sh:targetClass lease:LeasingProspect ;
  sh:property [ sh:path lease:leasingProspectName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path lease:leasingProspectFirstContactDate ; sh:name "first contact date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path lease:leasingProspectBrand ; sh:name "brand" ; sh:class party:Brand ; sh:maxCount 1 ] ,
    [ sh:path lease:leasingProspectCategory ; sh:name "category" ; sh:class party:MerchandiseCategory ; sh:maxCount 1 ] ,
    [ sh:path lease:leasingProspectBroker ; sh:name "broker" ; sh:class party:Broker ; sh:maxCount 1 ] .
lease:LeasingProposalShape a sh:NodeShape ; rdfs:label "Leasing Proposal requirements" ; sh:targetClass lease:LeasingProposal ;
  sh:property [ sh:path lease:leasingProposalProposalNumber ; sh:name "proposal number" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path lease:leasingProposalProposalDate ; sh:name "proposal date" ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path lease:leasingProposalProposedMinimumRent ; sh:name "proposed minimum rent" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path lease:leasingProposalProposedTermMonths ; sh:name "proposed term months" ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path lease:leasingProposalStatus ; sh:name "status" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 ] ,
    [ sh:path lease:leasingProposalProspect ; sh:name "prospect" ; sh:class lease:LeasingProspect ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path lease:leasingProposalUnit ; sh:name "unit" ; sh:class asset:LeasableUnit ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path lease:leasingProposalResultingLease ; sh:name "resulting lease" ; sh:class lease:Lease ; sh:maxCount 1 ] .
lease:LeaseStatusShape a sh:NodeShape ; rdfs:label "Lease Status requirements" ; sh:targetClass lease:LeaseStatus ;
  sh:property [ sh:path lease:leaseStatusCode ; sh:name "code" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path lease:leaseStatusName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] .
lease:LeaseShape a sh:NodeShape ; rdfs:label "Lease requirements" ; sh:targetClass lease:Lease ;
  sh:property [ sh:path lease:leaseLeaseNumber ; sh:name "lease number" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 ] ,
    [ sh:path lease:leaseSigningDate ; sh:name "signing date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path lease:leaseStartDate ; sh:name "start date" ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:minCount 1 ; sh:lessThanOrEquals lease:leaseEndDate ] ,
    [ sh:path lease:leaseEndDate ; sh:name "end date" ; sh:datatype xsd:date ; sh:maxCount 1 ; sh:minCount 1 ] ,
    [ sh:path lease:leaseTermMonths ; sh:name "term months" ; sh:datatype xsd:integer ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path lease:leaseStoreOpeningDate ; sh:name "store opening date" ; sh:datatype xsd:date ; sh:maxCount 1 ] ,
    [ sh:path lease:leaseMonthlyMinimumRent ; sh:name "monthly minimum rent" ; sh:datatype xsd:decimal ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
    [ sh:path lease:leaseHasThirteenthRent ; sh:name "has thirteenth rent" ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ,
    [ sh:path lease:leaseTenant ; sh:name "tenant" ; sh:class party:Tenant ; sh:maxCount 1 ; sh:minCount 1 ] ,
