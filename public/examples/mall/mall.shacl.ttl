core:PartyShape a sh:NodeShape ; rdfs:label "Party requirements" ; sh:targetClass core:Party ;
  sh:property core:Party_nameShape ,
    core:Party_legalNameShape ,
    core:Party_taxIdShape ,
    core:Party_emailShape ,
    core:Party_phoneShape ,
    core:Party_addressShape .
core:Party_nameShape a sh:PropertyShape ; rdfs:label "Party: name" ; sh:path core:partyName ; sh:name "name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minCount 1 ; sh:minLength 1 .
core:Party_legalNameShape a sh:PropertyShape ; rdfs:label "Party: legal name" ; sh:path core:partyLegalName ; sh:name "legal name" ; sh:datatype xsd:string ; sh:maxCount 1 ; sh:minLength 1 .
