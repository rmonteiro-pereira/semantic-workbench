u:OrderShape a sh:NodeShape ; rdfs:label "Order aggregate roles" ; sh:targetClass u:Order ;
 sh:property [ sh:path u:Order_QuotationDocumentReference ; sh:class u:DocumentReference ; sh:minCount 0 ; sh:maxCount 1 ] ,
